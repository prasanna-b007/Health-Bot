# Copy to .env and fill in. .env is gitignored.

# Shared secret required on every request to the Rasa REST API.
# Generate one with:  openssl rand -hex 32
RASA_AUTH_TOKEN=

# Comma-separated allowed origins for browser clients.
# Leave empty for native mobile apps -- they send no Origin header.
# Never use "*" on a deployment reachable from the internet.
RASA_CORS=

# Host port for the Rasa API (bound to 127.0.0.1 by compose).
RASA_PORT=5005

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tag applied to built images.
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Stateless triage API (docker compose --profile api up)
# ---------------------------------------------------------------------------
# Only needed if you run the FastAPI service in backend/api. The Rasa services
# above ignore all of these.

# Shared secret required on every request. The service refuses to start
# without it unless HEALTHBOT_ALLOW_UNAUTHENTICATED=true.
# Generate one with:  openssl rand -hex 32
HEALTHBOT_API_TOKEN=

# Signs the conversation state the client carries between turns. Must be set,
# and must be IDENTICAL across replicas -- a session signed by one instance is
# rejected by another with a different key.
# Generate one with:  openssl rand -hex 32
HEALTHBOT_STATE_SECRET=

# Prevalence prior to use when ranking conditions. One of:
#   global | south_asia | sub_saharan_africa | europe | north_america
# Dengue, typhoid, malaria and tuberculosis are routine presentations in some
# of these and vanishingly rare in others, so this materially changes results.
# An unrecognised value logs a warning and falls back to global.
HEALTHBOT_REGION=global

# Requests allowed per client per minute.
HEALTHBOT_RATE_LIMIT=60

# Comma-separated allowed origins for browser clients. Empty for mobile.
HEALTHBOT_CORS=

# Host port for the API (bound to 127.0.0.1 by compose).
API_PORT=8000
