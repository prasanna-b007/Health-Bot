# ---------------------------------------------------------------------------
# Python / Rasa
# ---------------------------------------------------------------------------
# Match at any depth. The previous rules were written as healthbot/... and
# stopped applying when the directory was renamed to backend/, which is how
# ~640 cache and model files ended up tracked and the repository grew past
# 700 MB.
venv/
rasa_env/
.rasa_env/
pyvenv.cfg
__pycache__/
*.pyc
*.pyo

# Rasa build artefacts: regenerated by `rasa train`, never reviewable in a diff.
# The model directory is scoped to backend/ on purpose -- a bare `models/`
# would also swallow the Flutter app's lib/models/ source.
.rasa/
backend/models/
*.tar.gz
scratch/
results/
.pytest_cache/

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
*.env
env.json
!env.example.json
secrets.yml

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local deployment configuration
.env
