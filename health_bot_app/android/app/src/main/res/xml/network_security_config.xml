<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: TLS only.

  The manifest previously set android:usesCleartextTraffic="true", which
  permitted plain HTTP to any host for the whole app. That is convenient
  against a laptop-hosted Rasa server and unacceptable for shipping software
  that carries symptom data.

  The debug variant overrides this file (see src/debug/res/xml) to allow
  cleartext to local development addresses only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
